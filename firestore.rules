rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lecture réservée aux visiteurs authentifiés (auth anonyme depuis le
    // tableau de bord). Aucune écriture côté client : seul le compte de
    // service du backend écrit, via l'Admin SDK qui contourne ces règles.
    match /offres/{offerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
